{
    "id": "nodebb-plugin-ep-api",
    "name": "ElasticPress API Integration",
    "description": "Integrates ElasticPress.io Elasticsearch service with NodeBB",
    "url": "https://github.com/OneGuidePortal/nodebb-ep-api",
    "library": "./library.js",
    "hooks": [
        { "hook": "static:app.load", "method": "init" },
        { "hook": "filter:admin.header.build", "method": "addAdminNavigation" }
    ],
    "staticDirs": {
        "static": "./public"
    },
    "templates": "./public/templates",
    "modules": {
        "../admin/plugins/ep-api.js": "public/admin.js"
    }
}
